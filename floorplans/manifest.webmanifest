{
  "name": "Applebrook Floor Plans",
  "short_name": "Floor Plans",
  "description": "Floor plans for Applebrook Golf Club",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#101512",
  "theme_color": "#1d6a45",
  "icons": [
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    }
  ],
  "file_handlers": [
    {
      "action": "./",
      "name": "Floor plan layout",
      "accept": {
        "application/x-applebrook-floorplan": [
          ".floorplan"
        ]
      },
      "icons": [
        {
          "src": "floorplan-file-256.png",
          "sizes": "256x256",
          "type": "image/png"
        },
        {
          "src": "floorplan-file-64.png",
          "sizes": "64x64",
          "type": "image/png"
        }
      ]
    }
  ]
}