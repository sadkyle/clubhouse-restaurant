{
  "name": "Applebrook Floor Plans",
  "short_name": "Floor Plans",
  "description": "Floor plans for Applebrook Golf Club",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#101512",
  "theme_color": "#1d6a45",
  "icons": [
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" }
  ],
  "file_handlers": [
    {
      "action": "./",
      "name": "Floor plan layout",
      "accept": { "application/x-applebrook-floorplan": [".floorplan"] }
    }
  ]
}
